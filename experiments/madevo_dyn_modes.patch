 _C.MIXED_PRECISION = True
 
+# --- MADEVO : modes d'injection du masque dynamique à l'inférence (défauts = comportement
+# publié : le masque n'atténue que la score map). Voir paper/experiments/.
+# p <- p ** DYN_GAMMA avant tout usage (température ; 1.0 = inchangé)
+_C.DYN_GAMMA = 1.0
+# atténue aussi la confiance ω de la BA par (1 - p) au centre de chaque patch
+_C.DYN_BA_WEIGHT = False
+# suppression amont (baseline type Pellerito et al.) : met à zéro les voxels où p > seuil,
+# et n'atténue PAS la score map
+_C.DYN_DELETE = False
+_C.DYN_DELETE_THRESH = 0.5
+
 cfg = _C
